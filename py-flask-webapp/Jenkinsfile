pipeline {
    agent any

    environment {
        IMAGE_NAME = 'python-flask-app'
        CONTAINER_NAME = 'gracious_goldberg'
        PORT = '5000'
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "📥 Cloning source code from GitHub..."
                git url: 'https://github.com/kishoreg9988/assignment-4.git', branch: 'sample-py-webapp'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "🐳 Building Docker image for the Flask app..."
                sh '''
                    docker stop $CONTAINER_NAME || true
                    docker rm $CONTAINER_NAME || true
                    docker rmi $IMAGE_NAME || true
                    docker build -t $IMAGE_NAME .
                '''
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "🧪 Running unit tests using unittest module..."
                sh '''
                    docker run --rm $IMAGE_NAME python3 -m unittest discover -s tests -p '*_test.py'
                '''
            }
        }

        stage('Deploy Container') {
            steps {
                echo "🚀 Deploying Flask container..."
                sh '''
                    docker run -d -p $PORT:5000 --name $CONTAINER_NAME $IMAGE_NAME
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo "🔍 Checking if app is live..."
                sh '''
                    sleep 5
                    curl -f http://localhost:$PORT || (echo "❌ Health check failed!" && exit 1)
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline executed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check above logs.'
        }
        always {
            echo '🧹 Cleaning up dangling Docker images...'
            sh 'docker image prune -f'
        }
    }
}

